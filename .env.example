# .env.example

# Cloudflare Bindings
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# Blockchain Configuration
BLOCKCHAIN_NODE_URL=your_blockchain_node_url
BLOCKCHAIN_NETWORK=your_network_name

# Token Addresses
TOKEN_ADDRESS_1=your_token_address_1
TOKEN_ADDRESS_2=your_token_address_2
TOKEN_ADDRESS_3=your_token_address_3

# ─── Treasury Core API (Elligent) — Phase 3 ──────────────────────────────────
# ExecDaat acts EXCLUSIVELY as a client of the Elligent Treasury Core API.
# Base URL of the Elligent Treasury Core API. When empty, the app transparently
# falls back to the legacy LOCAL path (zero regression) until Elligent provisions
# the endpoint. Accepts EITHER the origin (https://core.elligentt.xyz) OR the full
# base including the path (https://core.elligentt.xyz/api/core/v1) — the Worker
# normalizes it so the canonical path is never duplicated.
TREASURY_CORE_URL=

# Public application identity (non-sensitive)
APPLICATION_ID=EXECDAAT
CLIENT_ID=EXECDAAT-PROD
API_VERSION=v1
APPLICATION_MODE=REMOTE

# Feature flag controlling the execution source: LOCAL | REMOTE (default REMOTE).
# Phase 4: REMOTE is the definitive, normal operating mode. LOCAL is kept ONLY
# for emergency operational rollback (all fallbacks are logged in observability).
TREASURY_MODE=REMOTE

# Server-side ONLY secret used to authenticate against the Treasury Core API.
# The Worker signs each request with Timestamp + Nonce + HMAC-SHA256 using this
# secret. It is injected as request headers by the proxy — NEVER exposed to the
# browser. Set via `wrangler secret put TREASURY_APPLICATION_SECRET` in production.
TREASURY_APPLICATION_SECRET=

# ─── Autonomous Treasury Keys (server-side ONLY) ─────────────────────────────
# Private key of the Turbo Relayer — signs bridge deposit/fulfillment txs on
# behalf of the Treasury. The Worker uses this key to automatically execute
# Turbo Bridge transactions (CCTP depositForBurn + fulfillment) without manual
# wallet confirmation. Set via `wrangler secret put TURBO_RELAYER_PRIVATE_KEY`.
TURBO_RELAYER_PRIVATE_KEY=

# Private key of the ArcVault Operator — signs settlement transactions (reserve,
# startSettlement, completeSettlement) autonomously. The Worker uses this key
# to settle inbound bridge transfers through the ArcVault contract pipeline.
# Set via `wrangler secret put OPERATOR_PRIVATE_KEY` in production.
OPERATOR_PRIVATE_KEY=
