# ExecDaat Platform — Cloudflare Pages Security Headers
# Applied at the CDN edge — runs BEFORE the Worker
# These complement the headers set by the Hono security middleware
#
# Anti-phishing context:
#   These headers signal to security scanners (GoPlus, OKX Wallet, ScamSniffer,
#   PhishFort, Cloudflare Radar) that this is a legitimate Web3 dApp.
#   Scanners check HSTS, CSP, X-Frame-Options and Permissions-Policy as
#   positive trust signals when classifying a domain.

/*
  # ── IDENTITY & TRUST SIGNALS (read by GoPlus / OKX Wallet scanners) ──────────

  # Declares this as a Web3 dApp — helps GoPlus and wallet security APIs
  # distinguish it from phishing sites that typically omit this header
  X-Dapp-Name: ExecDaat Platform
  X-Dapp-Category: compliance-send
  X-Dapp-Chain: arc-testnet-5042002

  # ── TRANSPORT SECURITY ───────────────────────────────────────────────────────

  # Strict Transport Security — 2-year max-age, all subdomains, preload list
  # Phishing sites almost never have HSTS preloaded — this is a strong trust signal
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # ── CONTENT INTEGRITY ────────────────────────────────────────────────────────

  # Prevent MIME-type sniffing (stops Content-Type confusion attacks)
  X-Content-Type-Options: nosniff

  # Clickjacking protection — only self-origin embeds allowed
  X-Frame-Options: SAMEORIGIN

  # Legacy XSS filter for IE/old Edge
  X-XSS-Protection: 1; mode=block

  # Referrer policy — don't leak path/query to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # ── PERMISSIONS POLICY ───────────────────────────────────────────────────────
  # Explicitly disabling unused APIs is a strong signal of a legitimate site.
  # Phishing kits rarely set this header.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self), usb=(), magnetometer=(), accelerometer=(), gyroscope=(), fullscreen=(self), interest-cohort=(), browsing-topics=(), join-ad-interest-group=(), run-ad-auction=()

  # ── CROSS-ORIGIN ISOLATION ───────────────────────────────────────────────────
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # No cross-domain Flash/PDF policies
  X-Permitted-Cross-Domain-Policies: none

  # Remove server fingerprinting
  Server: ExecDaat/1.0

  # ── CONTENT SECURITY POLICY ──────────────────────────────────────────────────
  # A strict, explicit CSP is one of the strongest anti-phishing signals.
  # GoPlus and OKX scanners parse the CSP to verify the site doesn't load
  # from unknown/malicious origins.
  #
  # - Scripts: self + known CDNs only (Tailwind, JSDelivr, cdnjs)
  # - Styles:  self + CDNs + Google Fonts
  # - Fonts:   self + JSDelivr + Google Fonts
  # - Images:  self + data: + blob: (receipt viewer)
  # - Connect: self + Arc Testnet RPCs + ArcScan
  # - Frames:  self only (wallet providers)
  # - Objects: none (no Flash/Java)
  # - Workers: self + blob (service workers)
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://cdn.jsdelivr.net https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.arcscan.app; connect-src 'self' https://rpc.testnet.arc.network https://rpc.blockdaemon.testnet.arc.network https://rpc.drpc.testnet.arc.network https://rpc.quicknode.testnet.arc.network wss://rpc.testnet.arc.network https://testnet.arcscan.app https://api.coingecko.com https://ethereum-sepolia-rpc.publicnode.com https://sepolia-rollup.arbitrum.io https://sepolia.base.org https://sepolia.optimism.io https://iris-api-sandbox.circle.com https://api.circle.com https://sepolia.arbiscan.io https://sepolia.basescan.org https://sepolia-optimism.etherscan.io https://sepolia.etherscan.io; media-src 'none'; object-src 'none'; frame-src 'self'; worker-src 'self' blob:; form-action 'self'; base-uri 'self'; manifest-src 'self'; upgrade-insecure-requests

# API endpoints — no-cache, tight CORS
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, private
  Pragma: no-cache
  Expires: 0
  # CORS restricted to Pages origins — wildcard removed
  Access-Control-Allow-Origin: https://arc-ai-agents.pages.dev
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization, X-CSRF-Token, X-Session-Id, X-Client-Timestamp, X-Tab-Id, X-Requested-With
  Access-Control-Max-Age: 600
  Vary: Origin

# Static assets — long cache with immutable flag (versioned filenames)
/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ── OTC MODULE FILES — no-cache (critical security fix deployment) ────────────
# These files use content-hash in filename for versioning (e.g. otc.28392e1f.js)
# We override to no-cache so fixes propagate immediately to all users.
# Background: the ?v= query-string approach does NOT bust browser cache when
# Cache-Control: immutable is set. Hash-in-name + no-cache is the correct fix.
/static/otc*.js
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  X-Content-Type-Options: nosniff

# Security JS — no-cache so security fixes propagate immediately to all users
# (immutable from /static/* rule was preventing updates)
/static/security.js
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  X-Content-Type-Options: nosniff

# Multisend JS — no-cache so fixes propagate immediately to all users.
# The immutable /static/* rule was serving a stale copy (missing msEditAll and
# other v7 functions) under an old ?v= URL. Revalidate on every load instead.
/static/multisend.js
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  X-Content-Type-Options: nosniff

# HTML pages — no caching (always fresh)
/*.html
  Cache-Control: no-store

# Service Worker (if added in future)
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate
  Service-Worker-Allowed: /

# ── SECURITY & TRUST FILES ────────────────────────────────────────────────────
# These endpoints are checked by GoPlus, OKX Wallet scanner, ScamSniffer and
# PhishFort as part of their domain legitimacy verification.

# PWA Manifest — verifies dApp identity (name, chain, category)
/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json
  Access-Control-Allow-Origin: *

# Security.txt — RFC 9116 responsible disclosure file
# Presence of this file is a strong positive trust signal for security scanners
/.well-known/security.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
