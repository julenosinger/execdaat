{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020", "DOM"],
    "outDir": ".vercel/output/functions",
    "rootDir": ".",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false
  },
  "include": ["api/**/*", "src/routes/**/*", "src/middleware/**/*", "src/types/**/*", "src/html-template.ts"],
  "exclude": ["node_modules", "dist", "dist-vercel", ".wrangler"]
}
